DEFINE COMPONENT Annulus

SETTING PARAMETERS (radius=0, thickness=0)

SHARE
%{
%}

DECLARE
%{
%}

INITIALIZE
%{
%}


TRACE %{
  /* component Annulus does nothing */
%}

MCDISPLAY
%{
  // Draws a annulus with center at (x,y,z) with extent (radius) and remove thickness.
  mcdis_annulus (0, 0, 0, radius, thickness, 0, 1, 0);
%}

END
