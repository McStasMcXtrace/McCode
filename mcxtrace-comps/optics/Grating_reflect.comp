/*******************************************************************************
*
* McXtrace, x-ray tracing package
*         Copyright, All rights reserved
*         DTU Physics, Kgs. Lyngby, Denmark
*         Synchrotron SOLEIL, Saint-Aubin, France
*
* Component: Grating_reflect
*
* %Identification
* Written by: Erik B Knudsen (erkn@fysik.dtu.dk), Kristian Sorensen and Philip Smith
* Date: June 2021
* Version: 1.7
* Origin: DTU
*
* A reflective grating.
*
* %Description
* A reflective grating that diffracts incident photons.
* The grating is in the XZ-plane; the lines run along X, so the dispersion direction is Z.
* The outgoing direction is computed EXACTLY from the grating equation in the Y-Z plane
*   kz_out = kz_in - order * 2*pi/d
*   ky_out = +sqrt(k^2 - kx^2 - kz_out^2)      (reflected to the +y side; one-sided grating)
* which is valid also for conical (out-of-plane, kx != 0) mounting.
* A MC picked angle delta_theta, uniform in [-d_phi/2, d_phi/2], is then applied as a
* rotation in the (ky,kz) plane around the chosen diffraction direction, i.e. the
* sampling window is centered on the chosen order (or on phi0).
* The Monte Carlo weight of the ray is adjusted wrt. the grating interference pattern
* and the diffraction pattern associated with each grating line (all lines equal).
* For more efficient sampling of a particular direction the centre of the d_phi window
* may be shifted using the parameters order or phi0.
*
* NB: the absolute normalization of the weights (the pdir factor) follows the original
* scheme, i.e. the pattern is normalized as if spread over 2*pi. Integrated efficiencies
* should be validated against a reference grating for quantitative use.
*
* Example: Grating_reflect(
*   d_phi=1,order=0,rho_l=100,zdepth=102e-3,xwidth=102e-3)
*
* %Parameters
* Input parameters:
* xwidth: [m]     The width of the grating (along x).
* zdepth: [m]     The length of the grating (along z, the dispersion direction).
* R0:     [0-1]   Constant reflectivity of the grating [0;1]. Now actually applied.
* rho_l:  [l/mm]  Number of lines pr mm of the grating (along z).
* d:      internal [AA] grating pitch = 1e7/rho_l (computed; not a setting).
* b:      internal [AA] effective line width, default d/3 (computed; not a setting).
* nslits: internal [1] number of illuminated lines = zdepth[mm]*rho_l (computed; not a setting).
* d_phi:  [deg]   Range of diffraction angle that is to be simulated -d_phi/2 ; d_phi/2.
* order:  [1]     The target order of the grating. The d_phi window is centered on this order line.
* phi0:   [deg]   Target angle (from the grating surface) to center d_phi. If nonzero it
*                 overrides the order-based centering.
* verbose:[0/1]   If non-zero, more information will be displayed. Nb. generates much output.
*
* %End
*******************************************************************************/

/*
* Changelog v1.7 (fixes, physics of in-plane cases unchanged):
* - R0 was validated but never applied in TRACE; it now multiplies the weight.
* - Rays traveling towards -z received the WRONG diffraction order sign (the old
*   4-branch alpha/beta rotation logic was only correct for kz >= 0). The outgoing
*   direction is now computed directly from the grating equation, exact for any kz
*   and for out-of-plane (kx != 0) incidence.
* - Backside incidence (from y < 0) previously produced a "reflected" ray with ky > 0
*   (transmitted direction) and possibly nonzero weight; it is now absorbed.
* - The interference/diffraction phases now use the kz component only. The old code
*   used the full 3D angle to the normal, so all ray weights were wrong whenever
*   kx != 0.
* - nslits is a double, validated >= 1 (was int, could be 0 -> division by zero).
* - sinc terms guarded at x=0 (0/0 -> 1) instead of returning NaN at line center.
* - Evanescent orders (kz_out beyond the Ewald sphere) absorb instead of propagating
*   with a mirror-flipped direction and p=0.
* - SCATTER added; p==0 rays are absorbed.
*/

DEFINE COMPONENT Grating_reflect
SETTING PARAMETERS (d_phi=1, R0=1, rho_l=800,
    order=0, phi0=0,
    zdepth=0.015, xwidth=0.136, int verbose=0)

SHARE
%{
  %include "mccode-complex-lib"
  %include "read_table-lib"
%}

DECLARE
%{
  double pdir;
  double d;
  double b;
  double nslits;
%}

INITIALIZE
%{
  /* validate all inputs, not just R0 */
  if (R0 < 0 || R0 > 1) {
    fprintf (stderr, "ERROR: (%s) reflectivity (%f) is specified but is not in [0:1]. \n", NAME_CURRENT_COMP, R0);
    exit (-1);
  }
  if (rho_l <= 0) {
    fprintf (stderr, "ERROR: (%s) line density rho_l (%g) must be positive. \n", NAME_CURRENT_COMP, rho_l);
    exit (-1);
  }
  if (d_phi <= 0) {
    fprintf (stderr, "ERROR: (%s) sampling width d_phi (%g) must be positive. \n", NAME_CURRENT_COMP, d_phi);
    exit (-1);
  }
  if (xwidth <= 0 || zdepth <= 0) {
    fprintf (stderr, "ERROR: (%s) grating must have positive xwidth and zdepth. \n", NAME_CURRENT_COMP);
    exit (-1);
  }

  d = 1e7 / rho_l;                    /* grating pitch in Angstrom (rho_l in lines/mm) */
  b = d / 3;                          /* default effective line width in Angstrom */
  /* nslits must be >= 1,
     otherwise pdiff/pow(nslits,2) below divided by zero. */
  nslits = (zdepth * 1e3) * rho_l;    /* number of illuminated lines */
  if (nslits < 1) {
    fprintf (stderr, "ERROR: (%s) less than one grating line is illuminated (zdepth=%g m, rho_l=%g l/mm). \n",
             NAME_CURRENT_COMP, zdepth, rho_l);
    exit (-1);
  }

  if (verbose) {
    printf ("INFO: (%s): Line pitch, d=%f [AA]. Number of lines, N=%f. Line width, b=%f [AA].\n \n",
            NAME_CURRENT_COMP, d, nslits, b);
  }

  /*We are not sampling the full 2pi range*/
  pdir = (((d_phi * DEG2RAD)) / (2 * M_PI));
%}

TRACE
%{
  double kx_in, ky_in, kz_in;
  double kz_out, ky_out, k_yz2;
  double k, G;
  double delta_theta, rho;
  double gamma, Gamma, pdiff;

  /* Placing the grating along the Y-axis (PROP_Y0 absorbs ky==0 and
     backward-going rays in the current McCode runtime). */
  PROP_Y0;

  /*If the photon is passing the grating, it shouldn't be reflected. Instead, for book-keeping, it is restored to previous state before the component using
   * RESTORE_XRAY */
  if (x < -xwidth / 2.0 || x > xwidth / 2.0 || z < -zdepth / 2.0 || z > zdepth / 2.0) {
    RESTORE_XRAY (INDEX_CURRENT_COMP, x, y, z, kx, ky, kz, phi, t, Ex, Ey, Ez, p);
  } else {
    k = sqrt (scalar_prod (kx, ky, kz, kx, ky, kz));
    kx_in = kx;
    ky_in = ky;
    kz_in = kz;

    /* A reflective grating is one-sided:
       absorb backside hits. After PROP_Y0, ky > 0 means the ray reached the
       surface from the y < 0 side. */
    if (ky > 0) {
      ABSORB;
    }

    /* Grating vector along z: G = 2*pi/d, both in AA^-1 (d in AA, k in AA^-1). */
    G = 2 * M_PI / d;

    if (phi0) {
      /* a target angle is specified: outgoing angle measured from the grating
         SURFACE is phi0 (deg), keeping the kz travel sense. */
      double psi_target = phi0 * DEG2RAD;
      double sgn = (kz_in >= 0) ? 1.0 : -1.0;
      kz_out = sgn * k * sin (psi_target);
    } else {
      /* exact grating equation, kz_out = kz_in - order*G.
         Direct application of the grating equation is exact
         for any kz, and also for out-of-plane (kx != 0) mounting. */
      kz_out = kz_in - order * G;
    }

    /* Reflected side (+y), energy conserving: */
    k_yz2 = k * k - kx_in * kx_in - kz_out * kz_out;
    if (k_yz2 <= 0) {
      /* evanescent order (beyond the Ewald sphere). */
      ABSORB;
    }
    ky_out = sqrt (k_yz2);

    /* MC picked angle: uniform in [-d_phi/2, d_phi/2], applied as a rotation in
       the (ky,kz) plane around the diffraction direction chosen above. */
    delta_theta = DEG2RAD * (rand01 () * d_phi - (d_phi * 0.5));
    rho = delta_theta;
    kx = kx_in;
    ky = ky_out * cos (rho) - kz_out * sin (rho);
    kz = ky_out * sin (rho) + kz_out * cos (rho);

    SCATTER;

    /* Finding the weight using diffraction theory.
       the phases use the kz components directly (k, kz in AA^-1,
       d, b in AA), i.e. gamma = d*(kz_out - kz_in) and Gamma = b*(kz_out - kz_in).
       At the exact line center gamma is a multiple of 2*pi and both fractions
       below are 0/0; the sinc limits are applied explicitly. */
    gamma = d * (kz_out - kz_in);
    Gamma = b * (kz_out - kz_in);

    /* single-line (sinc^2) factor with 0/0 -> 1 */
    double xg = Gamma / 2;
    double sinc_G = (fabs (xg) < DBL_EPSILON) ? 1.0 : sin (xg) / xg;
    /* N-line interference factor with 0/0 -> N */
    double xh = gamma / 2;
    double sh = sin (xh), shN = sin (nslits * xh);
    double inter = (fabs (sh) < DBL_EPSILON) ? nslits : shN / sh;

    pdiff = (sinc_G * sinc_G) * (inter * inter);

    /* R0 is validated in INITIALIZE and applied.
       pdir carries the sampling-window normalization (d_phi_rad/2pi). */
    p = p * R0 * pdir * (pdiff / (nslits * nslits));

    /*catch dead rays*/
    if (p == 0)
      ABSORB;
  }
%}

/************************************************************************************************************
  Making lines to illustrate with the TRACE option.
*************************************************************************************************************/
MCDISPLAY
%{
  magnify ("");
  line (-xwidth / 2.0, 0, -zdepth / 2.0, xwidth / 2.0, 0, -zdepth / 2.0);
  line (-xwidth / 2.0, 0, zdepth / 2.0, xwidth / 2.0, 0, zdepth / 2.0);
  line (-xwidth / 2.0, 0, -zdepth / 2.0, -xwidth / 2.0, 0, zdepth / 2.0);
  line (xwidth / 2.0, 0, -zdepth / 2.0, xwidth / 2.0, 0, zdepth / 2.0);
  int i;
  int Nlines = 20;
  for (i = 0; i <= Nlines; i++) {
    double zz = -zdepth / 2.0 + i * zdepth / Nlines;
    line (-xwidth / 2.0, 0, zz, xwidth / 2.0, 0, zz);
  }
%}

END
