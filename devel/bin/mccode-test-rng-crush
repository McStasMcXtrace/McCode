#!/usr/bin/env bash
# TestU01 (SmallCrush / Crush / BigCrush) on the McCode per-particle RNGs.
#
# The generators are taken verbatim from common/lib/share/mccode-r.c, so the
# test covers what ships. The default "perray" mode reproduces how McCode uses
# them: ray i is seeded with srandom(_hash(_hash(seed) + i)) (as generated by
# cogen.c.in) and draws DRAWS numbers, then ray i+1 follows, and so on. This
# tests the per-ray seeding as well as the generator. "single" feeds one long
# stream from a single seed. TestU01 takes 32-bit words: "hi" tests the top 32
# bits of each 64-bit output (the bits rand01() mostly depends on), "lo" the bottom.
#
# Usage:
#   mccode-test-rng-crush [--battery small|crush|big] [--alg kiss|tinymt]
#                         [--mode perray|single] [--draws N] [--bits hi|lo]
#                         [--seed S] [--testu01 PREFIX] [--build-testu01 PREFIX]
#
#   --testu01 PREFIX        TestU01 install prefix (include/, lib/); or set TESTU01_DIR
#   --build-testu01 PREFIX  clone TestU01 (umontreal-simul/TestU01-2009, pinned) and
#                           install it into PREFIX first
#
# Run time, one battery, one generator, modern CPU: small ~10 s, crush ~30-60 min,
# big ~3-6 h. A run passes when TestU01 reports "All tests were passed"; a few
# p-values in the 1e-3 .. 1e-4 range across many runs are normal, while
# p < 1e-10 (or a test failing again with another seed) is a real failure.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
RUNTIME="$REPO/common/lib/share/mccode-r.c"
TESTU01_URL=https://github.com/umontreal-simul/TestU01-2009.git
TESTU01_REV=57e98bf33880

battery=small; alg=tinymt; mode=perray; draws=32; bits=hi; seed=1000
prefix="${TESTU01_DIR:-}"; build=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --battery) battery=$2; shift 2;;
    --alg) alg=$2; shift 2;;
    --mode) mode=$2; shift 2;;
    --draws) draws=$2; shift 2;;
    --bits) bits=$2; shift 2;;
    --seed) seed=$2; shift 2;;
    --testu01) prefix=$2; shift 2;;
    --build-testu01) build=$2; prefix=$2; shift 2;;
    -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0;;
    *) echo "unknown option: $1" >&2; exit 2;;
  esac
done
case $battery in small) bat=SmallCrush;; crush) bat=Crush;; big) bat=BigCrush;; *) echo "bad --battery" >&2; exit 2;; esac
case $alg in kiss|tinymt) ;; *) echo "bad --alg" >&2; exit 2;; esac
case $mode in perray|single) ;; *) echo "bad --mode" >&2; exit 2;; esac
case $bits in hi|lo) ;; *) echo "bad --bits" >&2; exit 2;; esac

if [[ -n $build ]]; then
  src=$(mktemp -d "${TMPDIR:-/tmp}/testu01-src.XXXXXX")
  git clone -q "$TESTU01_URL" "$src"
  git -C "$src" checkout -q "$TESTU01_REV"
  chmod +x "$src"/configure "$src"/install-sh "$src"/mkinstalldirs "$src"/missing "$src"/depcomp "$src"/config.guess "$src"/config.sub  # repo lacks exec bits
  host=(); [[ $(uname -s) == Darwin ]] && host=(--build="$(uname -m | sed 's/arm64/aarch64/')-apple-darwin")
  (cd "$src" && ./configure -q --prefix="$build" --disable-shared "${host[@]}" CFLAGS="-O2 -std=gnu89 -w" \
     && make -s -j"$( (nproc || sysctl -n hw.ncpu) 2>/dev/null)" && make -s install) >"$src/build.log" 2>&1 \
     || { tail -30 "$src/build.log"; echo "TestU01 build failed (log: $src/build.log)" >&2; exit 2; }
  echo "TestU01 installed in $build"
fi
[[ -n $prefix && -f $prefix/include/bbattery.h ]] || { echo "TestU01 not found: use --testu01 PREFIX, TESTU01_DIR, or --build-testu01 PREFIX" >&2; exit 2; }

work=$(mktemp -d "${TMPDIR:-/tmp}/rng-crush.XXXXXX")
{
  echo '#include <stdint.h>'
  echo '#include <stdio.h>'
  echo '#include "unif01.h"'
  echo '#include "bbattery.h"'
  echo '#define randstate_t uint64_t'
  sed -n '/^randstate_t _hash(randstate_t x) {/,/^}/p' "$RUNTIME"
  sed -n '/^uint64_t \*kiss_srandom(uint64_t state\[7\]/,/end of "KISS" rng/p' "$RUNTIME"
  sed -n '/^#define TINYMT64_MAT1/,/end of "TinyMT64" rng/p' "$RUNTIME"
  cat <<C
#define ALG_$alg 1
#define MODE_$mode 1
#define BITS_$bits 1
static uint64_t st[7], ray = 0, left = 0;
static const uint64_t seed = ${seed}ULL, draws = ${draws}ULL;
static void sr(uint64_t k) {
#ifdef ALG_kiss
  kiss_srandom(st, k);
#else
  tinymt64_srandom(st, k);
#endif
}
static uint64_t rnd(void) {
#ifdef MODE_perray
  if (!left) { sr(_hash(_hash(seed) + ray++)); left = draws; }
  left--;
#endif
#ifdef ALG_kiss
  return kiss_random(st);
#else
  return tinymt64_random(st);
#endif
}
static unsigned int gen32(void) {
#ifdef BITS_hi
  return (unsigned int)(rnd() >> 32);
#else
  return (unsigned int)rnd();
#endif
}
int main(void) {
  char name[128];
#ifdef MODE_single
  sr(seed);
#endif
  snprintf(name, sizeof name, "McCode %s, %s (%llu draws/ray), %s 32 bits, seed %llu",
           "$alg", "$mode", (unsigned long long)draws, "$bits", (unsigned long long)seed);
  unif01_Gen *g = unif01_CreateExternGenBits(name, gen32);
  bbattery_$bat(g);
  unif01_DeleteExternGenBits(g);
  return 0;
}
C
} > "$work/crush.c"
grep -q tinymt64_random "$work/crush.c" || { echo "TinyMT64 not found in $RUNTIME (branch without RNG_ALG=3?)" >&2; exit 2; }

cc -O2 -std=c99 -I"$prefix/include" -o "$work/crush" "$work/crush.c" \
   -L"$prefix/lib" -ltestu01 -lprobdist -lmylib -lm
echo "Running $bat: alg=$alg mode=$mode draws=$draws bits=$bits seed=$seed (log: $work/crush.log)"
"$work/crush" | tee "$work/crush.log"
grep -q "All tests were passed" "$work/crush.log"
